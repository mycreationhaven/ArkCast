# Resolve the official PeerTube v8.2.4 image to a trusted immutable digest.
# Example shape only; do not copy this placeholder literally.
PEERTUBE_IMAGE=chocobozzz/peertube@sha256:REPLACE_WITH_VERIFIED_DIGEST
PEERTUBE_EXPECTED_VERSION=8.2.4
PEERTUBE_HOST_PORT=9000

POSTGRES_DB=peertube
POSTGRES_USER=arkcast_peertube
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD_AT_LEAST_32_CHARACTERS

REDIS_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD_AT_LEAST_32_CHARACTERS

PEERTUBE_DB_HOSTNAME=postgres
PEERTUBE_DB_NAME=peertube
PEERTUBE_DB_USERNAME=arkcast_peertube
PEERTUBE_DB_PASSWORD=REPLACE_WITH_THE_SAME_POSTGRES_PASSWORD
PEERTUBE_DB_SSL=false
PEERTUBE_REDIS_HOSTNAME=redis
PEERTUBE_REDIS_AUTH=REPLACE_WITH_THE_SAME_REDIS_PASSWORD

PEERTUBE_LISTEN_HOSTNAME=0.0.0.0
PEERTUBE_LISTEN_PORT=9000
PEERTUBE_WEBSERVER_HOSTNAME=peertube.localhost
PEERTUBE_WEBSERVER_PORT=9000
PEERTUBE_WEBSERVER_HTTPS=false
PEERTUBE_TRUST_PROXY=["loopback"]
PEERTUBE_SECRET=REPLACE_WITH_RANDOM_HEX_SECRET_AT_LEAST_64_CHARACTERS

# Evaluation email is intentionally non-deliverable.
PEERTUBE_SMTP_HOSTNAME=127.0.0.1
PEERTUBE_SMTP_PORT=25
PEERTUBE_SMTP_FROM=noreply@arkcast.invalid
PEERTUBE_SMTP_TLS=false
PEERTUBE_ADMIN_EMAIL=admin@arkcast.invalid
