# Comma-separated, operator-controlled Arkovia HTTP API origins.
# Never accept blockchain node URLs from public request parameters.
ARKOVIA_NODE_URLS=http://127.0.0.1:27876
ARKOVIA_HEALTH_PATH=/nxt?requestType=getBlockchainStatus
ARKOVIA_REQUEST_TIMEOUT_MS=3000
ARKOVIA_MAX_PUBLICATION_FEE_NQT=300000000
ARKCAST_GATEWAY_HOST=127.0.0.1
ARKCAST_GATEWAY_PORT=8787
